{
  "name": "ares",
  "private": true,
  "version": "0.1.0",
  "description": "Assistant IA Ares avec mode local Ollama et mode en ligne.",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.ares.assistant",
    "productName": "Ares",
    "directories": { "output": "dist" },
    "files": ["electron/**/*", "src/**/*", "package.json"],
    "win": { "target": ["nsis"] },
    "mac": { "target": ["dmg"] },
    "linux": { "target": ["AppImage", "deb"] }
  }
}
